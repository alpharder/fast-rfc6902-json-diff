{
  "name": "@alpharder/fast-rfc6902-json-diff",
  "version": "1.0.1",
  "description": "The fastest RFC 6902 JSON diff generator. Compact array diffs, optional move detection and zero runtime dependencies. Built for Node.js and Bun.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpharder/fast-rfc6902-json-diff.git"
  },
  "homepage": "https://github.com/alpharder/fast-rfc6902-json-diff#readme",
  "bugs": {
    "url": "https://github.com/alpharder/fast-rfc6902-json-diff/issues"
  },
  "keywords": [
    "json",
    "json-diff",
    "json-patch",
    "rfc6902",
    "rfc6901",
    "json-pointer",
    "diff",
    "array-diff",
    "myers",
    "lcs",
    "move-detection",
    "typescript",
    "javascript",
    "zero-dependencies"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "prebuild-checks": "npm-run-all -c tsc-lint lint",
    "build": "tsup src/index.ts --dts --format esm,cjs --minify --treeshake --target es2020 --clean && node scripts/finalize-build.mjs",
    "check": "npm-run-all prebuild-checks test:types test check:package",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "ava",
    "test:types": "tsc -p tsconfig.types.json",
    "tsc-lint": "tsc --noEmit",
    "lint": "eslint ./src ./type-tests"
  },
  "ava": {
    "timeout": "20s",
    "files": [
      "src/tests/**/*"
    ],
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "author": "Alexander Bolshakov",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node16-strictest": "^1.0.3",
    "@types/lodash": "^4.14.184",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "ava": "^4.3.3",
    "eslint": "^8.32.0",
    "fast-json-patch": "^3.1.1",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.3",
    "tsx": "^4.21.0",
    "tsup": "^6.5.0",
    "typescript": "^4.9.4"
  }
}
